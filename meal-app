<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Simple Meal Tracker</title>
<style>
:root{
  --bg:#f6f7f9;
  --card:#ffffff;
  --text:#15171a;
  --muted:#7a8088;
  --line:#e8eaed;
  --accent:#111827;
  --soft:#eef0f3;
  --good:#237a57;
  --danger:#b42318;
}
*{box-sizing:border-box}
body{
  margin:0;
  background:var(--bg);
  color:var(--text);
  font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
}
button,input,select{font:inherit}
button{cursor:pointer}
.app{
  width:min(100%,520px);
  margin:0 auto;
  min-height:100vh;
  padding:24px 16px 96px;
}
.topbar{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:12px;
  margin-bottom:22px;
}
.brand{font-size:22px;font-weight:750;letter-spacing:-.03em}
.date{font-size:13px;color:var(--muted)}
.screen{display:none}
.screen.active{display:block}
h1{font-size:28px;margin:0 0 6px;letter-spacing:-.04em}
.sub{color:var(--muted);font-size:14px;margin-bottom:18px}
.card{
  background:var(--card);
  border:1px solid var(--line);
  border-radius:18px;
  padding:18px;
  margin-bottom:12px;
}
.card-title{
  font-size:13px;
  color:var(--muted);
  margin-bottom:8px;
}
.big-number{
  font-size:40px;
  font-weight:800;
  letter-spacing:-.05em;
}
.big-number span{font-size:18px;color:var(--muted);font-weight:600}
.progress{
  height:9px;
  background:var(--soft);
  border-radius:999px;
  overflow:hidden;
  margin:14px 0 8px;
}
.progress > div{
  height:100%;
  width:0%;
  background:var(--accent);
  border-radius:inherit;
  transition:width .2s ease;
}
.row{display:flex;align-items:center;justify-content:space-between;gap:12px}
.grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:10px;
}
.stat{
  background:var(--card);
  border:1px solid var(--line);
  border-radius:16px;
  padding:14px;
}
.stat b{display:block;font-size:18px;margin-top:5px}
.stat span{font-size:12px;color:var(--muted)}
.meal-tabs{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  background:var(--soft);
  padding:4px;
  border-radius:14px;
  margin-bottom:14px;
}
.meal-tab{
  border:0;
  background:transparent;
  padding:10px 6px;
  border-radius:10px;
  color:var(--muted);
  font-weight:650;
}
.meal-tab.active{
  background:var(--card);
  color:var(--text);
  box-shadow:0 1px 3px rgba(0,0,0,.08);
}
.food-row{
  display:flex;
  align-items:center;
  gap:12px;
  padding:13px 0;
  border-bottom:1px solid var(--line);
}
.food-row:last-child{border-bottom:0}
.food-info{flex:1;min-width:0}
.food-name{font-weight:650}
.food-meta{font-size:12px;color:var(--muted);margin-top:3px}
.icon-btn{
  width:34px;height:34px;border-radius:10px;
  border:1px solid var(--line);
  background:var(--card);
}
.primary{
  border:0;
  background:var(--accent);
  color:white;
  border-radius:13px;
  padding:12px 14px;
  font-weight:700;
}
.secondary{
  border:1px solid var(--line);
  background:var(--card);
  color:var(--text);
  border-radius:13px;
  padding:11px 13px;
  font-weight:650;
}
.full{width:100%}
.empty{
  text-align:center;
  color:var(--muted);
  padding:28px 8px;
  font-size:14px;
}
.input-group{margin-bottom:12px}
label{display:block;font-size:12px;color:var(--muted);margin-bottom:6px}
input,select{
  width:100%;
  border:1px solid var(--line);
  border-radius:12px;
  padding:12px;
  background:white;
  color:var(--text);
  outline:none;
}
input:focus,select:focus{border-color:#aab0b8}
.inline{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:10px;
}
.chart-wrap{height:220px}
canvas{width:100%;height:100%}
.nav{
  position:fixed;
  bottom:0;
  left:50%;
  transform:translateX(-50%);
  width:min(100%,520px);
  display:grid;
  grid-template-columns:repeat(3,1fr);
  background:rgba(255,255,255,.96);
  backdrop-filter:blur(14px);
  border-top:1px solid var(--line);
  padding:8px 10px max(8px,env(safe-area-inset-bottom));
}
.nav button{
  border:0;background:transparent;
  padding:9px 4px 7px;
  color:var(--muted);
  font-size:12px;
  font-weight:650;
}
.nav button.active{color:var(--text)}
.nav .nav-icon{font-size:19px;display:block;margin-bottom:2px}
.modal{
  position:fixed;inset:0;
  background:rgba(15,23,42,.38);
  display:none;
  align-items:flex-end;
  justify-content:center;
  z-index:20;
}
.modal.open{display:flex}
.sheet{
  width:min(100%,520px);
  max-height:85vh;
  overflow:auto;
  background:white;
  border-radius:24px 24px 0 0;
  padding:20px 16px 24px;
}
.sheet-head{
  display:flex;justify-content:space-between;align-items:center;margin-bottom:16px
}
.sheet h2{margin:0;font-size:20px}
.close{
  width:36px;height:36px;border:0;border-radius:50%;background:var(--soft)
}
.library-item{
  display:flex;align-items:center;gap:10px;padding:11px 0;border-bottom:1px solid var(--line)
}
.library-item:last-child{border-bottom:0}
.library-item .food-info{cursor:pointer}
.qty{
  width:70px;
  padding:9px;
}
.danger{
  border:0;background:#fff1f0;color:var(--danger);border-radius:10px;padding:8px 10px;font-weight:650
}
.goal-edit{display:flex;gap:8px;align-items:end}
.goal-edit .input-group{flex:1;margin:0}
.small-note{font-size:12px;color:var(--muted);line-height:1.45}
.weight-row{
  display:flex;justify-content:space-between;align-items:center;padding:11px 0;border-bottom:1px solid var(--line)
}
.weight-row:last-child{border-bottom:0}
.delta{font-size:12px;color:var(--muted)}
@media (max-width:370px){
  .grid{grid-template-columns:1fr}
}
</style>
</head>
<body>
<div class="app">
  <div class="topbar">
    <div class="brand">Meal Tracker</div>
    <div class="date" id="todayLabel"></div>
  </div>

  <section id="dashboard" class="screen active">
    <h1>Dashboard</h1>
    <div class="sub">Your daily summary at a glance.</div>

    <div class="card">
      <div class="card-title">Calories today</div>
      <div class="big-number"><span id="caloriesEaten">0</span> <span>kcal</span></div>
      <div class="progress"><div id="calorieProgress"></div></div>
      <div class="row small-note">
        <span id="goalText">Goal: 2,000 kcal</span>
        <span id="remainingText">2,000 remaining</span>
      </div>
    </div>

    <div class="grid">
      <div class="stat"><span>Breakfast</span><b id="dashBreakfast">0</b><span>kcal</span></div>
      <div class="stat"><span>Lunch</span><b id="dashLunch">0</b><span>kcal</span></div>
      <div class="stat"><span>Dinner</span><b id="dashDinner">0</b><span>kcal</span></div>
    </div>

    <div class="card">
      <div class="row">
        <div>
          <div class="card-title">Latest weight</div>
          <div class="big-number" style="font-size:30px"><span id="latestWeight">—</span> <span>kg</span></div>
        </div>
        <button class="secondary" onclick="showScreen('weight')">Log weight</button>
      </div>
    </div>

    <div class="card">
      <div class="card-title">Daily calorie goal</div>
      <div class="goal-edit">
        <div class="input-group">
          <input id="goalInput" type="number" min="500" step="50" value="2000">
        </div>
        <button class="primary" onclick="saveGoal()">Save</button>
      </div>
    </div>
  </section>

  <section id="meals" class="screen">
    <h1>Meals</h1>
    <div class="sub">Add foods from your saved food list.</div>

    <div class="meal-tabs">
      <button class="meal-tab active" data-meal="breakfast" onclick="selectMeal('breakfast')">Breakfast</button>
      <button class="meal-tab" data-meal="lunch" onclick="selectMeal('lunch')">Lunch</button>
      <button class="meal-tab" data-meal="dinner" onclick="selectMeal('dinner')">Dinner</button>
    </div>

    <div class="card">
      <div class="row" style="margin-bottom:4px">
        <div>
          <div class="card-title" id="mealTitle">Breakfast</div>
          <div style="font-size:24px;font-weight:800"><span id="mealTotal">0</span> kcal</div>
        </div>
        <button class="primary" onclick="openFoodPicker()">+ Add food</button>
      </div>
      <div id="mealEntries"></div>
    </div>

    <button class="secondary full" onclick="openFoodManager()">Manage saved foods</button>
  </section>

  <section id="weight" class="screen">
    <h1>Weight</h1>
    <div class="sub">Log one weight per day and follow the trend.</div>

    <div class="card">
      <div class="inline">
        <div class="input-group">
          <label>Date</label>
          <input type="date" id="weightDate">
        </div>
        <div class="input-group">
          <label>Weight (kg)</label>
          <input type="number" id="weightValue" step="0.1" min="20" max="400" placeholder="85.0">
        </div>
      </div>
      <button class="primary full" onclick="saveWeight()">Save weight</button>
    </div>

    <div class="card">
      <div class="card-title">Weight trend</div>
      <div class="chart-wrap"><canvas id="weightChart"></canvas></div>
    </div>

    <div class="card">
      <div class="card-title">Recent entries</div>
      <div id="weightHistory"></div>
    </div>
  </section>
</div>

<nav class="nav">
  <button class="active" data-screen="dashboard" onclick="showScreen('dashboard')"><span class="nav-icon">⌂</span>Dashboard</button>
  <button data-screen="meals" onclick="showScreen('meals')"><span class="nav-icon">🍽</span>Meals</button>
  <button data-screen="weight" onclick="showScreen('weight')"><span class="nav-icon">↗</span>Weight</button>
</nav>

<div class="modal" id="foodPickerModal">
  <div class="sheet">
    <div class="sheet-head">
      <h2>Add food</h2>
      <button class="close" onclick="closeModal('foodPickerModal')">×</button>
    </div>
    <div id="foodPickerList"></div>
    <div class="small-note" style="margin-top:14px">Food calories are stored per serving. Change the quantity before adding if you ate more or less than one serving.</div>
  </div>
</div>

<div class="modal" id="foodManagerModal">
  <div class="sheet">
    <div class="sheet-head">
      <h2>Saved foods</h2>
      <button class="close" onclick="closeModal('foodManagerModal')">×</button>
    </div>

    <div class="input-group">
      <label>Food name</label>
      <input id="newFoodName" placeholder="e.g. Chicken breast">
    </div>
    <div class="inline">
      <div class="input-group">
        <label>Serving</label>
        <input id="newFoodServing" placeholder="e.g. 100 g">
      </div>
      <div class="input-group">
        <label>Calories</label>
        <input id="newFoodCalories" type="number" min="0" placeholder="165">
      </div>
    </div>
    <button class="primary full" onclick="addSavedFood()">Add saved food</button>

    <div style="height:14px"></div>
    <div id="foodManagerList"></div>
  </div>
</div>

<script>
const STORAGE_KEY = "simpleMealTracker_v1";

const defaultState = {
  goal: 2000,
  foods: [
    {id:"f1", name:"Egg", serving:"1 large", calories:72},
    {id:"f2", name:"Chicken breast", serving:"100 g", calories:165},
    {id:"f3", name:"Cooked rice", serving:"100 g", calories:130},
    {id:"f4", name:"Broccoli", serving:"100 g", calories:35},
    {id:"f5", name:"Apple", serving:"1 medium", calories:95},
    {id:"f6", name:"2% milk", serving:"200 ml", calories:100}
  ],
  meals: {},
  weights: []
};

let state = loadState();
let selectedMeal = "breakfast";

function loadState(){
  try{
    const saved = JSON.parse(localStorage.getItem(STORAGE_KEY));
    if(!saved) return structuredClone(defaultState);
    return {
      goal: saved.goal || 2000,
      foods: Array.isArray(saved.foods) ? saved.foods : structuredClone(defaultState.foods),
      meals: saved.meals || {},
      weights: Array.isArray(saved.weights) ? saved.weights : []
    };
  }catch{
    return structuredClone(defaultState);
  }
}
function persist(){
  localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
}

function localDateKey(d = new Date()){
  const y = d.getFullYear();
  const m = String(d.getMonth()+1).padStart(2,"0");
  const day = String(d.getDate()).padStart(2,"0");
  return `${y}-${m}-${day}`;
}
const todayKey = localDateKey();

function getDayMeals(){
  if(!state.meals[todayKey]){
    state.meals[todayKey] = {breakfast:[], lunch:[], dinner:[]};
  }
  return state.meals[todayKey];
}
function mealCalories(meal){
  return getDayMeals()[meal].reduce((sum,item)=>sum + item.calories * item.qty,0);
}
function dayCalories(){
  return ["breakfast","lunch","dinner"].reduce((sum,m)=>sum+mealCalories(m),0);
}

function showScreen(id){
  document.querySelectorAll(".screen").forEach(s=>s.classList.toggle("active",s.id===id));
  document.querySelectorAll(".nav button").forEach(b=>b.classList.toggle("active",b.dataset.screen===id));
  if(id==="dashboard") renderDashboard();
  if(id==="meals") renderMeal();
  if(id==="weight") renderWeight();
}
function selectMeal(meal){
  selectedMeal = meal;
  document.querySelectorAll(".meal-tab").forEach(b=>b.classList.toggle("active",b.dataset.meal===meal));
  renderMeal();
}

function renderDashboard(){
  const total = Math.round(dayCalories());
  const goal = Number(state.goal) || 2000;
  const remaining = goal-total;
  document.getElementById("caloriesEaten").textContent = total.toLocaleString();
  document.getElementById("goalText").textContent = `Goal: ${goal.toLocaleString()} kcal`;
  document.getElementById("remainingText").textContent = remaining >= 0 ? `${remaining.toLocaleString()} remaining` : `${Math.abs(remaining).toLocaleString()} over`;
  document.getElementById("calorieProgress").style.width = `${Math.min(100,(total/goal)*100)}%`;
  document.getElementById("dashBreakfast").textContent = Math.round(mealCalories("breakfast"));
  document.getElementById("dashLunch").textContent = Math.round(mealCalories("lunch"));
  document.getElementById("dashDinner").textContent = Math.round(mealCalories("dinner"));
  document.getElementById("goalInput").value = goal;

  const sorted = [...state.weights].sort((a,b)=>a.date.localeCompare(b.date));
  document.getElementById("latestWeight").textContent = sorted.length ? Number(sorted.at(-1).weight).toFixed(1) : "—";
}
function saveGoal(){
  const v = Number(document.getElementById("goalInput").value);
  if(!v || v < 500) return alert("Enter a valid calorie goal.");
  state.goal=v;
  persist();
  renderDashboard();
}

function renderMeal(){
  const title = selectedMeal[0].toUpperCase()+selectedMeal.slice(1);
  document.getElementById("mealTitle").textContent=title;
  document.getElementById("mealTotal").textContent=Math.round(mealCalories(selectedMeal));
  const box=document.getElementById("mealEntries");
  const items=getDayMeals()[selectedMeal];

  if(!items.length){
    box.innerHTML='<div class="empty">No food added yet.</div>';
    return;
  }

  box.innerHTML=items.map((item,index)=>`
    <div class="food-row">
      <div class="food-info">
        <div class="food-name">${escapeHtml(item.name)}</div>
        <div class="food-meta">${escapeHtml(item.serving)} × ${item.qty} · ${Math.round(item.calories*item.qty)} kcal</div>
      </div>
      <button class="icon-btn" title="Remove" onclick="removeMealItem(${index})">×</button>
    </div>
  `).join("");
}
function removeMealItem(index){
  getDayMeals()[selectedMeal].splice(index,1);
  persist();
  renderMeal();
}

function openFoodPicker(){
  renderFoodPicker();
  document.getElementById("foodPickerModal").classList.add("open");
}
function renderFoodPicker(){
  const box=document.getElementById("foodPickerList");
  if(!state.foods.length){
    box.innerHTML='<div class="empty">No saved foods. Add some from “Manage saved foods”.</div>';
    return;
  }
  box.innerHTML=state.foods.map(food=>`
    <div class="library-item">
      <div class="food-info">
        <div class="food-name">${escapeHtml(food.name)}</div>
        <div class="food-meta">${escapeHtml(food.serving)} · ${food.calories} kcal</div>
      </div>
      <input class="qty" type="number" min="0.25" step="0.25" value="1" id="qty_${food.id}">
      <button class="primary" onclick="addFoodToMeal('${food.id}')">Add</button>
    </div>
  `).join("");
}
function addFoodToMeal(id){
  const food=state.foods.find(f=>f.id===id);
  if(!food) return;
  const qty=Number(document.getElementById(`qty_${id}`).value);
  if(!qty || qty<=0) return;
  getDayMeals()[selectedMeal].push({
    name:food.name,
    serving:food.serving,
    calories:Number(food.calories),
    qty
  });
  persist();
  renderMeal();
  closeModal("foodPickerModal");
}

function openFoodManager(){
  renderFoodManager();
  document.getElementById("foodManagerModal").classList.add("open");
}
function renderFoodManager(){
  const box=document.getElementById("foodManagerList");
  box.innerHTML = state.foods.length ? state.foods.map(food=>`
    <div class="library-item">
      <div class="food-info">
        <div class="food-name">${escapeHtml(food.name)}</div>
        <div class="food-meta">${escapeHtml(food.serving)} · ${food.calories} kcal</div>
      </div>
      <button class="danger" onclick="deleteSavedFood('${food.id}')">Delete</button>
    </div>
  `).join("") : '<div class="empty">No saved foods.</div>';
}
function addSavedFood(){
  const name=document.getElementById("newFoodName").value.trim();
  const serving=document.getElementById("newFoodServing").value.trim();
  const calories=Number(document.getElementById("newFoodCalories").value);
  if(!name || !serving || !Number.isFinite(calories) || calories<0){
    return alert("Enter a food name, serving, and valid calories.");
  }
  state.foods.push({
    id:"f_"+Date.now(),
    name, serving, calories
  });
  persist();
  document.getElementById("newFoodName").value="";
  document.getElementById("newFoodServing").value="";
  document.getElementById("newFoodCalories").value="";
  renderFoodManager();
}
function deleteSavedFood(id){
  state.foods=state.foods.filter(f=>f.id!==id);
  persist();
  renderFoodManager();
}
function closeModal(id){
  document.getElementById(id).classList.remove("open");
}

function saveWeight(){
  const date=document.getElementById("weightDate").value;
  const weight=Number(document.getElementById("weightValue").value);
  if(!date || !weight || weight<20 || weight>400) return alert("Enter a valid date and weight.");
  const existing=state.weights.find(w=>w.date===date);
  if(existing) existing.weight=weight;
  else state.weights.push({date,weight});
  state.weights.sort((a,b)=>a.date.localeCompare(b.date));
  persist();
  document.getElementById("weightValue").value="";
  renderWeight();
}
function deleteWeight(date){
  state.weights=state.weights.filter(w=>w.date!==date);
  persist();
  renderWeight();
}
function renderWeight(){
  const items=[...state.weights].sort((a,b)=>a.date.localeCompare(b.date));
  const history=document.getElementById("weightHistory");
  if(!items.length){
    history.innerHTML='<div class="empty">No weight entries yet.</div>';
  }else{
    const recent=[...items].reverse().slice(0,10);
    history.innerHTML=recent.map((w,i)=>{
      const originalIndex=items.findIndex(x=>x.date===w.date);
      const prev=originalIndex>0 ? items[originalIndex-1] : null;
      const diff=prev ? w.weight-prev.weight : null;
      const delta=diff===null ? "" : `${diff>0?"+":""}${diff.toFixed(1)} kg`;
      return `
        <div class="weight-row">
          <div>
            <div class="food-name">${formatDate(w.date)}</div>
            <div class="delta">${delta}</div>
          </div>
          <div class="row">
            <b>${Number(w.weight).toFixed(1)} kg</b>
            <button class="icon-btn" onclick="deleteWeight('${w.date}')">×</button>
          </div>
        </div>
      `;
    }).join("");
  }
  drawWeightChart(items);
  renderDashboard();
}

function drawWeightChart(items){
  const canvas=document.getElementById("weightChart");
  const rect=canvas.getBoundingClientRect();
  const dpr=window.devicePixelRatio || 1;
  canvas.width=Math.max(1,rect.width*dpr);
  canvas.height=Math.max(1,rect.height*dpr);
  const ctx=canvas.getContext("2d");
  ctx.scale(dpr,dpr);
  const w=rect.width,h=rect.height;
  ctx.clearRect(0,0,w,h);

  if(!items.length){
    ctx.fillStyle="#7a8088";
    ctx.font="14px system-ui";
    ctx.textAlign="center";
    ctx.fillText("Your weight chart will appear here.",w/2,h/2);
    return;
  }

  const pad={l:42,r:12,t:18,b:30};
  const values=items.map(x=>Number(x.weight));
  let min=Math.min(...values), max=Math.max(...values);
  if(min===max){min-=1;max+=1}
  const extra=(max-min)*0.15 || 1;
  min-=extra;max+=extra;

  ctx.strokeStyle="#e8eaed";
  ctx.lineWidth=1;
  ctx.fillStyle="#7a8088";
  ctx.font="11px system-ui";
  ctx.textAlign="right";

  for(let i=0;i<4;i++){
    const y=pad.t+(h-pad.t-pad.b)*(i/3);
    const val=max-(max-min)*(i/3);
    ctx.beginPath();ctx.moveTo(pad.l,y);ctx.lineTo(w-pad.r,y);ctx.stroke();
    ctx.fillText(val.toFixed(1),pad.l-7,y+4);
  }

  const xFor=i => items.length===1 ? (pad.l+w-pad.r)/2 : pad.l+(w-pad.l-pad.r)*(i/(items.length-1));
  const yFor=v => pad.t+(max-v)/(max-min)*(h-pad.t-pad.b);

  ctx.strokeStyle="#111827";
  ctx.lineWidth=2.5;
  ctx.lineJoin="round";
  ctx.lineCap="round";
  ctx.beginPath();
  items.forEach((item,i)=>{
    const x=xFor(i), y=yFor(Number(item.weight));
    if(i===0) ctx.moveTo(x,y); else ctx.lineTo(x,y);
  });
  ctx.stroke();

  ctx.fillStyle="#111827";
  items.forEach((item,i)=>{
    const x=xFor(i),y=yFor(Number(item.weight));
    ctx.beginPath();ctx.arc(x,y,3.5,0,Math.PI*2);ctx.fill();
  });

  ctx.fillStyle="#7a8088";
  ctx.textAlign="center";
  const labelIndexes = items.length <= 4 ? items.map((_,i)=>i) : [0,Math.floor((items.length-1)/2),items.length-1];
  labelIndexes.forEach(i=>{
    ctx.fillText(shortDate(items[i].date),xFor(i),h-8);
  });
}
function formatDate(str){
  const d=new Date(str+"T00:00:00");
  return d.toLocaleDateString(undefined,{month:"short",day:"numeric",year:"numeric"});
}
function shortDate(str){
  const d=new Date(str+"T00:00:00");
  return d.toLocaleDateString(undefined,{month:"short",day:"numeric"});
}
function escapeHtml(value){
  return String(value).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"}[c]));
}

document.getElementById("todayLabel").textContent =
  new Date().toLocaleDateString(undefined,{weekday:"short",month:"short",day:"numeric"});
document.getElementById("weightDate").value=todayKey;

document.querySelectorAll(".modal").forEach(modal=>{
  modal.addEventListener("click",e=>{
    if(e.target===modal) modal.classList.remove("open");
  });
});
window.addEventListener("resize",()=> {
  if(document.getElementById("weight").classList.contains("active")) drawWeightChart([...state.weights].sort((a,b)=>a.date.localeCompare(b.date)));
});

getDayMeals();
persist();
renderDashboard();
renderMeal();
</script>
